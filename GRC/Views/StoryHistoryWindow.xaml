<Window
    x:Class="GRC.Views.StoryHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    Title="기억 및 서사 열람"
    Width="450"
    Height="550"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Icon="/Resources/GRC.ico"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterOwner">

    <!--  동적 배경 이미지 바인딩  -->
    <Window.Background>
        <ImageBrush ImageSource="{Binding CurrentBackgroundImage}" Stretch="UniformToFill" />
    </Window.Background>

    <Grid>
        <!--  가독성을 위한 전체 반투명 다크 오버레이  -->
        <Border Background="#D8121212" />

        <Grid Margin="20">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  현재 챕터  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        Background="#AA1A1D24"
                        BorderBrush="#442A2D35"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <!--  🌟 색상 통일: 제목(#D1D1D1), 본문(#C5CDD9)  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#D1D1D1"
                                Text="진행 중인 서사" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#C5CDD9"
                                LineHeight="20"
                                Text="{Binding CurrentChapterPlot}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  이전 챕터  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        Background="#AA1A1D24"
                        BorderBrush="#442A2D35"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <!--  🌟 색상 통일: 제목(#D1D1D1), 본문(#C5CDD9)  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#D1D1D1"
                                Text="지나간 서사들" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#C5CDD9"
                                LineHeight="20"
                                Text="{Binding PrevChapterPlot}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  과거의 이야기  -->
                    <Border
                        Margin="0,0,0,10"
                        Padding="12"
                        Background="#AA1A1D24"
                        BorderBrush="#442A2D35"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <!--  🌟 색상 통일: 제목(#D1D1D1), 본문(#C5CDD9)  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#D1D1D1"
                                Text="지나간 역사" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#C5CDD9"
                                LineHeight="20"
                                Text="{Binding LongTermSummaryText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>