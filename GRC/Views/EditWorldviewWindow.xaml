<Window
    x:Class="GRC.Views.EditWorldviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    Title="세계관 및 스탯 수정"
    Width="450"
    Height="850"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="#1E1E20"
    Icon="/Resources/GRC.ico"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#D1D1D1"
                Text="세계관 및 캐릭터 설정 (불변 법칙)" />
            <Button
                HorizontalAlignment="Right"
                Padding="8,4"
                Click="EditScenarioButton_Click"
                Style="{StaticResource SecondaryActionButton}">
                <TextBlock FontSize="12" Text="초기 시나리오 수정" />
            </Button>
        </Grid>
        <TextBox
            x:Name="WorldviewTextBox"
            Grid.Row="1"
            Padding="10"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <!-- 추가: 상태창 갱신가이드 -->
        <TextBlock
            Grid.Row="2"
            Margin="0,15,0,8"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D1D1D1"
            Text="상태창 갱신 가이드" />
        <TextBox
            x:Name="StatusUpdateGuideTextBox"
            Grid.Row="3"
            Padding="10"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <Grid Grid.Row="4" Margin="0,15,0,8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#D1D1D1"
                Text="추적할 커스텀 스탯" />
            <Button
                HorizontalAlignment="Right"
                Padding="10,4"
                Click="AddStatButton_Click"
                Style="{StaticResource SecondaryActionButton}">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="10"
                        Height="10"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Data="{StaticResource IconPlus}"
                        Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                        Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center" Text="스탯 추가" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            Grid.Row="5"
            Padding="10"
            Background="#18181A"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CustomStatsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Margin="0,0,10,0"
                                    Padding="10,8"
                                    Background="#121212"
                                    BorderBrush="#333333"
                                    Foreground="White"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Padding="10,8"
                                    Background="#121212"
                                    BorderBrush="#333333"
                                    Foreground="White"
                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="2"
                                    Width="36"
                                    Click="RemoveStatButton_Click"
                                    Style="{StaticResource DangerActionButton}"
                                    Tag="{Binding}"
                                    ToolTip="삭제">
                                    <Path
                                        Width="10"
                                        Height="10"
                                        Data="{StaticResource IconClose}"
                                        Stretch="Uniform"
                                        Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        StrokeThickness="2" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel
            Grid.Row="6"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Click="CancelButton_Click"
                Content="취소"
                Style="{StaticResource SecondaryActionButton}" />
            <Button
                Width="100"
                Click="SaveButton_Click"
                Content="저장"
                Style="{StaticResource PrimaryActionButton}" />
        </StackPanel>
    </Grid>
</Window>