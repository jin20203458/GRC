<Window
    x:Class="GRC.Views.EditWorldviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    Title="세계관 및 스탯 수정"
    Width="450"
    Height="750"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="#1E1E20"
    Icon="/Resources/GRC.ico"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#D1D1D1"
                Text="세계관 및 캐릭터 설정 (불변 법칙)" />
            <Button
                Padding="8,4"
                HorizontalAlignment="Right"
                Background="#2A2A2A"
                BorderThickness="0"
                Click="EditScenarioButton_Click"
                Cursor="Hand"
                Foreground="White">
                <TextBlock FontSize="12" Text="초기 시나리오 수정" />
            </Button>
        </Grid>
        <TextBox
            x:Name="WorldviewTextBox"
            Grid.Row="1"
            Padding="10"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <Grid Grid.Row="2" Margin="0,20,0,12">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="#D1D1D1"
                Text="추적할 커스텀 스탯" />
            <Button
                Padding="10,4"
                HorizontalAlignment="Right"
                Background="#2A2A2A"
                BorderThickness="0"
                Click="AddStatButton_Click"
                Content="+ 스탯 추가"
                Cursor="Hand"
                Foreground="White" />
        </Grid>

        <Border
            Grid.Row="3"
            Padding="10"
            Background="#18181A"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CustomStatsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Margin="0,0,10,0"
                                    Padding="10,8"
                                    Background="#121212"
                                    BorderBrush="#333333"
                                    Foreground="White"
                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Padding="10,8"
                                    Background="#121212"
                                    BorderBrush="#333333"
                                    Foreground="White"
                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="2"
                                    Width="36"
                                    Background="#2A1414"
                                    BorderThickness="0"
                                    Click="RemoveStatButton_Click"
                                    Content="✕"
                                    Cursor="Hand"
                                    Foreground="#FF5555"
                                    Tag="{Binding}"
                                    ToolTip="삭제" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel
            Grid.Row="4"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Click="CancelButton_Click"
                Style="{StaticResource HeaderActionButton}">
                <TextBlock Foreground="#AAAAAA" Text="취소" />
            </Button>
            <Button
                Width="100"
                Click="SaveButton_Click"
                Style="{StaticResource HeaderActionButton}">
                <TextBlock
                    FontWeight="Bold"
                    Foreground="White"
                    Text="저장" />
            </Button>
        </StackPanel>
    </Grid>
</Window>