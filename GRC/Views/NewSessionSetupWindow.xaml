<Window
    x:Class="GRC.Views.NewSessionSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    Title="새 대화 설정"
    Width="450"
    Height="750"
    Icon="/Resources/GRC.ico"
    Background="#1E1E20"
    WindowStartupLocation="CenterOwner"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0: 세션 이름 라벨 -->
            <RowDefinition Height="Auto" />
            <!-- 1: 세션 이름 입력 -->
            <RowDefinition Height="Auto" />
            <!-- 2: 세계관 라벨 -->
            <RowDefinition Height="*" />
            <!-- 3: 세계관 입력 -->
            <RowDefinition Height="Auto" />
            <!-- 4: 상태창 갱신가이드 라벨 -->
            <RowDefinition Height="*" />
            <!-- 5: 상태창 갱신가이드 입력 -->
            <RowDefinition Height="Auto" />
            <!-- 6: 시나리오 라벨 -->
            <RowDefinition Height="*" />
            <!-- 7: 시나리오 입력 -->
            <RowDefinition Height="Auto" />
            <!-- 8: 커스텀 스탯 라벨 -->
            <RowDefinition Height="Auto" />
            <!-- 9: 커스텀 스탯 입력 -->
            <RowDefinition Height="Auto" />
            <!-- 10: 하단 버튼 -->
        </Grid.RowDefinitions>

        <!-- 1. 세션(캐릭터) 이름 입력 -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D1D1D1"
            Text="세션 이름" />
        <TextBox
            x:Name="NameTextBox"
            Grid.Row="1"
            Margin="0,0,0,20"
            Padding="12"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White" />

        <!-- 2. 세계관 입력 -->
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D1D1D1"
            Text="세계관 및 캐릭터 설정 (불변 법칙)" />
        <TextBox
            x:Name="WorldviewTextBox"
            Grid.Row="3"
            Padding="12"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <!-- 추가: 상태창 갱신 가이드 입력 -->
        <TextBlock
            Grid.Row="4"
            Margin="0,20,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D1D1D1"
            Text="상태창 갱신 가이드 (선택 사항)" />
        <TextBox
            x:Name="StatusUpdateGuideTextBox"
            Grid.Row="5"
            Padding="12"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <!-- 3. 초기 시나리오 입력 -->
        <TextBlock
            Grid.Row="6"
            Margin="0,20,0,8"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="#D1D1D1"
            Text="초기 시나리오 (시작 상황)" />
        <TextBox
            x:Name="ScenarioTextBox"
            Grid.Row="7"
            Padding="12"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <!-- 6: 커스텀 스탯 라벨 및 추가 버튼 -->
        <Grid Grid.Row="8" Margin="0,20,0,8">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#D1D1D1" Text="추적할 커스텀 스탯 (선택 사항)" VerticalAlignment="Center" />
            <Button Click="AddStatButton_Click" Content="+ 스탯 추가" HorizontalAlignment="Right" Padding="10,4" Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </Grid>

        <!-- 7: 동적 스탯 입력 리스트 -->
        <ScrollViewer Grid.Row="9" Height="130" VerticalScrollBarVisibility="Auto">
            <!-- 항목들이 바인딩되어 동적으로 늘어나는 리스트 컨트롤 -->
            <ItemsControl x:Name="CustomStatsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <!-- 스탯 이름 칸 -->
                                <ColumnDefinition Width="1.5*" />
                                <!-- 스탯 값 칸 -->
                                <ColumnDefinition Width="Auto" />
                                <!-- 삭제 버튼 -->
                            </Grid.ColumnDefinitions>

                            <!-- 스탯 이름 입력 (예: 체력) -->
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="#121212" Foreground="White" BorderBrush="#2A2A2A" Padding="8" Margin="0,0,8,0" />

                            <!-- 초기값 입력 (예: 100/100) -->
                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Background="#121212" Foreground="White" BorderBrush="#2A2A2A" Padding="8" Margin="0,0,8,0" />

                            <!-- 해당 스탯 삭제 버튼 -->
                            <Button Grid.Column="2" Click="RemoveStatButton_Click" Tag="{Binding}" Content="✕" Width="30" Background="Transparent" Foreground="#FF5555" BorderThickness="0" Cursor="Hand" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. 하단 버튼 컨트롤 -->
        <StackPanel
            Grid.Row="10"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Click="CancelButton_Click"
                Style="{StaticResource HeaderActionButton}">
                <TextBlock Foreground="#AAAAAA" Text="취소" />
            </Button>
            <Button
                Width="100"
                Click="StartButton_Click"
                Style="{StaticResource HeaderActionButton}">
                <TextBlock FontWeight="Bold" Foreground="White" Text="대화 시작" />
            </Button>
        </StackPanel>
    </Grid>
</Window>