<Window
    x:Class="GRC.Views.EditInitialScenarioWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    Title="초기 시나리오 수정"
    Width="400"
    Height="300"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="#1E1E20"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,8"
            FontWeight="SemiBold"
            Foreground="#D1D1D1"
            Text="초기 시나리오" />

        <TextBox
            x:Name="ScenarioTextBox"
            Grid.Row="1"
            Padding="10"
            AcceptsReturn="True"
            Background="#121212"
            BorderBrush="#2A2A2A"
            Foreground="White"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                Background="#2A2A2A"
                BorderThickness="0"
                Click="BtnCancel_Click"
                Content="취소"
                Cursor="Hand"
                Foreground="#AAAAAA" />
            <Button
                Width="80"
                Background="#008B99"
                BorderThickness="0"
                Click="BtnSave_Click"
                Content="확인"
                Cursor="Hand"
                FontWeight="Bold"
                Foreground="White" />
        </StackPanel>
    </Grid>
</Window>