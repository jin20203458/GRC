<UserControl
    x:Class="GRC.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    xmlns:vm="clr-namespace:GRC.ViewModels">

    <UserControl.Background>
        <ImageBrush ImageSource="{Binding CurrentBackgroundImage}" Stretch="UniformToFill" />
    </UserControl.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="3"
            Background="#B5000000"
            IsHitTestVisible="False" />

        <Border
            Grid.Row="0"
            Background="#CC111111"
            BorderBrush="#222222"
            BorderThickness="0,0,0,1">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Command="{Binding GoBackCommand}"
                    Cursor="Hand"
                    Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconChevronLeft}"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#A0A0B0"
                            StrokeThickness="2" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#A0A0B0"
                            Text="뒤로" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Text="{Binding CurrentPreset.Name, FallbackValue='로딩 중...'}" />

                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding EditWorldviewCommand}"
                        Cursor="Hand"
                        Style="{StaticResource GhostButton}"
                        ToolTip="세계관 수정">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconEdit}"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#008B99"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>

                    <Button
                        Margin="5,0,0,0"
                        Command="{Binding EditLorebookCommand}"
                        Cursor="Hand"
                        Style="{StaticResource GhostButton}"
                        ToolTip="로어북 관리">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconBook}"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#008B99"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>

                    <Button
                        Margin="5,0,0,0"
                        Command="{Binding OpenStoryHistoryWindowCommand}"
                        Cursor="Hand"
                        Style="{StaticResource GhostButton}"
                        ToolTip="기억 열람">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconHistory}"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#008B99"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>
                    <Button
                        Margin="5,0,0,0"
                        Command="{Binding OpenArchitectForEditCommand}"
                        Cursor="Hand"
                        Style="{StaticResource GhostButton}"
                        ToolTip="AI 세션 아키텍트로 수정">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconSparkles}"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#008B99"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>

                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  상태창 버튼  -->
                    <Button
                        Margin="0,0,8,0"
                        Command="{Binding OpenStatusWindowCommand}"
                        Cursor="Hand"
                        Style="{StaticResource GhostButton}"
                        ToolTip="상태창">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconShield}"
                            Fill="Transparent"
                            Stretch="Uniform"
                            Stroke="#AAAAAA"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>
                    <!--  대화 비우기 버튼  -->
                    <Button
                        Command="{Binding ClearChatCommand}"
                        Cursor="Hand"
                        Style="{StaticResource GhostButton}"
                        ToolTip="대화 비우기">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource IconTrash}"
                            Fill="#AAAAAA"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===================== 수정된 채팅창 영역 =====================  -->
        <Grid Grid.Row="1">
            <!--  패널 속성은 ItemsControl에 Attached Property로 주는 것이 깔끔합니다  -->
            <ItemsControl
                x:Name="ChatHistoryItemsControl"
                Margin="10,20,10,0"
                ItemTemplate="{StaticResource ChatMessageTemplate}"
                ItemsSource="{Binding ChatHistory}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Standard">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <!--  [수정됨] AutoScroll 헬퍼는 반드시 ScrollViewer에 직접 붙여야 작동합니다  -->
                        <ScrollViewer
                            x:Name="ChatScrollViewer"
                            Padding="{TemplateBinding Padding}"
                            helpers:AutoScrollHelper.AutoScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>

            <StackPanel
                Margin="0,0,0,15"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">

                <!--  점 크기를 6->4로 줄이고 여백을 조정했습니다  -->
                <Ellipse
                    x:Name="Dot1"
                    Width="4"
                    Height="4"
                    Margin="3"
                    Fill="#008B99"
                    Opacity="0.3" />
                <Ellipse
                    x:Name="Dot2"
                    Width="4"
                    Height="4"
                    Margin="3"
                    Fill="#008B99"
                    Opacity="0.3" />
                <Ellipse
                    x:Name="Dot3"
                    Width="4"
                    Height="4"
                    Margin="3"
                    Fill="#008B99"
                    Opacity="0.3" />

                <!--  타이핑 애니메이션 (기존 유지)  -->
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Storyboard.TargetName="Dot1"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.3"
                                    To="1.0"
                                    Duration="0:0:0.3" />
                                <DoubleAnimation
                                    AutoReverse="True"
                                    BeginTime="0:0:0.15"
                                    Storyboard.TargetName="Dot2"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.3"
                                    To="1.0"
                                    Duration="0:0:0.3" />
                                <DoubleAnimation
                                    AutoReverse="True"
                                    BeginTime="0:0:0.3"
                                    Storyboard.TargetName="Dot3"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.3"
                                    To="1.0"
                                    Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>
            </StackPanel>
            <!--  기존에 있던 우측 상단 챕터/턴 정보 플로팅 UI 유지  -->
            <Border
                Margin="0,15,25,0"
                Padding="12,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#AA121212"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#008B99"
                        Text="CHAPTER " />
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Text="{Binding CurrentChapter}" />
                    <Rectangle
                        Width="1"
                        Height="10"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Fill="#444444" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#A0A0B0"
                        Text="TURN " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Text="{Binding CurrentTurn}" />
                </StackPanel>
            </Border>
        </Grid>
        <!--  =========================================================  -->

        <StackPanel Grid.Row="2" Margin="15,5,15,20">
            <TextBlock
                Margin="5,0,0,10"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="#8E8EA0"
                Text="AI가 적절한 답변을 고민하고 있습니다..."
                Visibility="{Binding IsLoadingSuggestions, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ItemsControl
                Margin="0,0,0,10"
                ItemTemplate="{StaticResource SuggestedReplyTemplate}"
                ItemsSource="{Binding SuggestedReplies}" />

            <Border
                x:Name="InputBorder"
                Padding="10"
                Background="#880B192C"
                CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#2A2A2A" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <!--  입력창을 클릭(Focus)했을 때  -->
                            <DataTrigger Binding="{Binding IsFocused, ElementName=InputTextBox}" Value="True">
                                <!--  기존 #008B99 앞에 투명도 88(약 55%)을 추가하여 은은하게 빛나게 만듦  -->
                                <Setter Property="BorderBrush" Value="#88008B99" />
                                <Setter Property="BorderThickness" Value="1.2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        MaxHeight="100"
                        Margin="0,0,0,10"
                        Padding="10,8"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="White"
                        FontSize="15"
                        Foreground="#EAEAEA"
                        PreviewKeyDown="InputTextBox_PreviewKeyDown"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <ToggleButton
                            Background="Transparent"
                            Command="{Binding ToggleSuggestionCommand}"
                            Cursor="Hand"
                            IsChecked="{Binding IsSuggestionEnabled, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Padding="8,4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconSparkles}"
                                                Fill="#008B99"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="추천답변" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#1A2B4C" />
                                            <Setter Property="BorderBrush" Value="#008B99" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="#66B2FF" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="#8E8EA0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ToggleButton
                            Margin="3,0,0,0"
                            Background="Transparent"
                            Cursor="Hand"
                            IsChecked="{Binding IsFastForwardEnabled, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Padding="8,4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="11"
                                                Height="14"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconHourglass}"
                                                Fill="#008B99"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="스킵" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="#1A2B4C" />
                                            <Setter Property="BorderBrush" Value="#008B99" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="#66B2FF" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="#8E8EA0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button
                            Margin="5,0,0,0"
                            Padding="8,4"
                            Click="BtnInsertDialogue_Click"
                            Cursor="Hand"
                            Style="{StaticResource GhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource IconMessageSquare}"
                                    Fill="#8E8EA0"
                                    Stretch="Uniform" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#8E8EA0"
                                    Text="대사" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="5,0,0,0"
                            Padding="8,4"
                            Click="BtnInsertThought_Click"
                            Cursor="Hand"
                            Style="{StaticResource GhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource IconBrain}"
                                    Fill="#8E8EA0"
                                    Stretch="Uniform" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#8E8EA0"
                                    Text="속마음" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnSend_Click"
                        Command="{Binding SendMessageCommand}"
                        Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <!--  SVG Path를 이용한 모던한 종이비행기 아이콘  -->
                                    <Path
                                        x:Name="IconPath"
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource IconSend}"
                                        Fill="#8E8EA0"
                                        Stretch="Uniform" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconPath" Property="Fill" Value="#008B99" />
                                    </Trigger>

                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter TargetName="IconPath" Property="Data" Value="{StaticResource IconStopSquare}" />

                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>