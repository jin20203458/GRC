<Window
    x:Class="GRC.Views.CustomMessageBoxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    Title="{Binding DialogTitle}"
    Width="380"
    Height="200"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="#1E1E20"
    Icon="/Resources/GRC.ico"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ToolWindow"
    PreviewKeyDown="Window_PreviewKeyDown"
    MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  팝업 메시지 내용  -->
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="#EAEAEA"
            Text="{Binding DialogMessage}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--  하단 버튼 영역  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <!--  취소 버튼 (Confirm 모드에서만 보임)  -->
            <Button
                x:Name="BtnCancel"
                Width="80"
                Margin="0,0,10,0"
                Padding="8,6"
                Click="BtnCancel_Click"
                Content="취소"
                IsCancel="True"
                Style="{StaticResource SecondaryActionButton}" />

            <!--  확인 버튼  -->
            <Button
                x:Name="BtnOk"
                Width="100"
                Padding="8,6"
                Click="BtnOk_Click"
                Content="확인"
                IsDefault="True"
                Style="{StaticResource PrimaryActionButton}" />
        </StackPanel>
    </Grid>
</Window>