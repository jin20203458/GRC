<Window
    x:Class="GRC.Views.EditLorebookWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:GRC.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="로어북(동적 배경지식) 설정"
    Width="1000"
    Height="650"
    helpers:WindowTitleBarBehavior.EnableDarkTitleBar="True"
    Background="#0F1115"
    FontFamily="Malgun Gothic"
    Foreground="#F2F2F2"
    Icon="/Resources/GRC.ico"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  💡 텍스트박스 입력 글꼴 크기 축소 (13.5 -> 12.5)  -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#22FFFFFF" />
                <Setter Property="Foreground" Value="#F2F2F2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="CaretBrush" Value="#F2F2F2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernLorebookButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#EAEAEA" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="Background" Value="#880B192C" />
                <Setter Property="BorderBrush" Value="#2E4A73" />
                <Setter Property="BorderThickness" Value="1.2" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="Background" Value="#AA14284A" />
                        <Setter Property="BorderBrush" Value="#4DA6FF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  리스트박스 아이템 스타일 유지  -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Foreground" Value="#AAB2C0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                Name="Border"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#33FFFFFF" />
                                    <Setter Property="Foreground" Value="#F2F2F2" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#AA14284A" />
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#4DA6FF" />
                                    <Setter Property="Foreground" Value="#F2F2F2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="15" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ================= 왼쪽: 로어북 항목 목록 =================  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#EAEAEA"
                    Text="로어북 목록" />

                <Button
                    x:Name="BtnSortCategory"
                    Margin="0,0,6,0"
                    Click="BtnSortCategory_Click"
                    Content="카테고리순"
                    Foreground="White"
                    Style="{StaticResource HeaderActionButton}" />
                <Button
                    x:Name="BtnSortPriority"
                    Click="BtnSortPriority_Click"
                    Content="우선순위순"
                    Foreground="White"
                    Style="{StaticResource GhostButton}" />
            </StackPanel>


            <Border
                Grid.Row="1"
                Padding="6"
                Background="#66050505"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="10">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding LorebookItems}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedLorebook}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Margin="0,1,0,0"
                                    FontSize="10"
                                    Foreground="#888888"
                                    Text="{Binding Category}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Click="BtnAdd_Click"
                    Content="추가"
                    Style="{StaticResource ModernLorebookButtonStyle}" />
                <Button
                    Grid.Column="2"
                    Click="BtnDelete_Click"
                    Content="삭제"
                    Style="{StaticResource ModernLorebookButtonStyle}" />
            </Grid>
        </Grid>

        <!--  ================= 오른쪽: 로어북 상세 편집 =================  -->
        <Border
            Grid.Column="2"
            Padding="20"
            Background="#99050505"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            CornerRadius="10">
            <Grid DataContext="{Binding SelectedLorebook}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  💡 안내 라벨 폰트 축소 (13 -> 11.5) 및 아래쪽 여백 조절  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    FontSize="11.5"
                    Foreground="#AAB2C0"
                    Text="항목 이름" />
                <TextBox
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11.5"
                            Foreground="#AAB2C0"
                            Text="트리거 키워드 (쉼표로 구분)" />
                        <TextBox Text="{Binding KeywordsString, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11.5"
                            Foreground="#AAB2C0"
                            Text="카테고리 (인물/장소/..)" />
                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11.5"
                            Foreground="#AAB2C0"
                            Text="우선순위 (0~)" />
                        <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" ToolTip="숫자가 낮을수록(0에 가까울수록) 스캔과 주입 우선순위가 높아집니다." />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="3"
                    Margin="0,0,0,4"
                    FontSize="11.5"
                    Foreground="#AAB2C0"
                    Text="로어북 내용 (스캔 시 주입될 설정)" />
                <TextBox
                    Grid.Row="4"
                    Margin="0,0,0,15"
                    AcceptsReturn="True"
                    Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <StackPanel
                    Grid.Row="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"
                        Content="취소"
                        Style="{StaticResource ModernLorebookButtonStyle}" />
                    <Button
                        Width="120"
                        Click="BtnSave_Click"
                        Content="저장 후 닫기"
                        Style="{StaticResource ModernLorebookButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>