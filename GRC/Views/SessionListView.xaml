
<UserControl
    x:Class="GRC.Views.SessionListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:GRC.ViewModels"
    Background="#121212"
    Loaded="UserControl_Loaded"
    Style="{StaticResource FadeInViewStyle}">

    <!--  (상단 헤더 영역 Grid.Row="0"은 기존과 동일하게 유지)  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  [기존 상단 헤더 코드 그대로 사용]  -->
        <Border
            Grid.Row="0"
            Background="#CC111111"
            BorderBrush="#222222"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="내 대화 목록" />
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Padding="12,6"
                        Command="{Binding CreateNewSessionCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="+" />
                            <TextBlock VerticalAlignment="Center" Text="새 대화 시작" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Command="{Binding OpenArchitectCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Data="M12,2L14.6,8.6L21,11L14.6,13.4L12,20L9.4,13.4L3,11L9.4,8.6L12,2M20.5,17L21.4,19.3L24,20L21.4,20.7L20.5,23L19.6,20.7L17,20L19.6,19.3L20.5,17"
                                Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                Stretch="Uniform"
                                VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center" Text="AI 세션 아키텍트" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <TextBlock VerticalAlignment="Center" Text="⚙ 설정" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  [수정된 카드 리스트 영역]  -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <Grid>
                <!--  세션이 0개일 때 나타나는 웰컴 온보딩 카드  -->
                <Border
                    Margin="30,40"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#18181A"
                    BorderBrush="#2A2A2D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="450" HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Text="🎭" />
                        <TextBlock
                            Margin="0,10,0,10"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="GRC에 오신 것을 환영합니다!" />
                        <TextBlock
                            Margin="0,0,0,25"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="#A0A0A0"
                            Text="한 줄의 키워드로 당신만의 AI 롤플레잉 서사를 만들어보세요."
                            TextWrapping="Wrap" />

                        <!--  상태별 안내 버튼  -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button
                                Padding="16,10"
                                Background="#3B82F6"
                                BorderThickness="0"
                                Command="{Binding OpenSettingsCommand}"
                                Cursor="Hand"
                                Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" Text="⚙" />
                                    <TextBlock FontWeight="Bold" Text="API 키 설정하기" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="12,0,0,0"
                                Padding="16,10"
                                Background="#10B981"
                                BorderThickness="0"
                                Command="{Binding OpenArchitectCommand}"
                                Cursor="Hand"
                                Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0" Text="✨" />
                                    <TextBlock FontWeight="Bold" Text="AI 세션 만들기" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  기존 세션 리스트  -->
                <ItemsControl Margin="15,0" ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionSummary}">
                        <Button
                            Margin="0,8"
                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!--  🌟 변경됨: 모델 말풍선(ModelDialogue)과 동일한 배경 및 테두리 적용  -->
                                    <Border
                                        x:Name="CardBorder"
                                        Padding="18,15"
                                        Background="#99050505"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="15"
                                                Opacity="0.1"
                                                ShadowDepth="2" />
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <!--  🌟 변경됨: 텍스트 색상을 모델 대사 색상(#F2F2F2)으로 통일  -->
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="#F2F2F2"
                                                    Text="{Binding PresetName}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    FontSize="11"
                                                    Foreground="#AAB2C0"
                                                    Text="{Binding LastModified, StringFormat='MM/dd HH:mm'}" />
                                            </DockPanel>

                                            <!--  🌟 변경됨: 프리뷰 텍스트도 모델 지문 색상(#AAB2C0)과 맞춰 차분하게 변경  -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                FontSize="13"
                                                Foreground="#AAB2C0"
                                                Text="{Binding LastMessagePreview}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!--  삭제 버튼  -->
                                            <Button
                                                Margin="0,-5,-10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#888888"
                                                    Text="✕" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!--  🌟 변경됨: 호버 시 모델 말풍선 테마에 맞게 약간만 더 밝은 다크/화이트톤으로 전환  -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="#BB111111" />
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#44FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!--  로딩 오버레이 (기존 유지)  -->
        <Border
            Grid.RowSpan="2"
            Background="#CC000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    FontSize="14"
                    Foreground="White"
                    Text="세션을 불러오는 중..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>