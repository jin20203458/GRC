
<UserControl
    x:Class="GRC.Views.SessionListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:GRC.ViewModels"
    Background="#121212"
    Loaded="UserControl_Loaded"
    Style="{StaticResource FadeInViewStyle}">

    <!--  (상단 헤더 영역 Grid.Row="0"은 기존과 동일하게 유지)  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  [기존 상단 헤더 코드 그대로 사용]  -->
        <Border
            Grid.Row="0"
            Background="#CC111111"
            BorderBrush="#222222"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="내 대화 목록" />
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Padding="12,6"
                        Command="{Binding CreateNewSessionCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="+" />
                            <TextBlock VerticalAlignment="Center" Text="새 대화 시작" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <TextBlock VerticalAlignment="Center" Text="⚙ 설정" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  [수정된 카드 리스트 영역]  -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <ItemsControl Margin="15,0" ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionSummary}">
                        <Button
                            Margin="0,8"
                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!--  🌟 변경됨: 모델 말풍선(ModelDialogue)과 동일한 배경 및 테두리 적용  -->
                                    <Border
                                        x:Name="CardBorder"
                                        Padding="18,15"
                                        Background="#99050505"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="15"
                                                Opacity="0.1"
                                                ShadowDepth="2" />
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <!--  🌟 변경됨: 텍스트 색상을 모델 대사 색상(#F2F2F2)으로 통일  -->
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="#F2F2F2"
                                                    Text="{Binding PresetName}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    FontSize="11"
                                                    Foreground="#AAB2C0"
                                                    Text="{Binding LastModified, StringFormat='MM/dd HH:mm'}" />
                                            </DockPanel>

                                            <!--  🌟 변경됨: 프리뷰 텍스트도 모델 지문 색상(#AAB2C0)과 맞춰 차분하게 변경  -->
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                FontSize="13"
                                                Foreground="#AAB2C0"
                                                Text="{Binding LastMessagePreview}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!--  삭제 버튼  -->
                                            <Button
                                                Margin="0,-5,-10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="#888888"
                                                    Text="✕" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!--  🌟 변경됨: 호버 시 모델 말풍선 테마에 맞게 약간만 더 밝은 다크/화이트톤으로 전환  -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="#BB111111" />
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#44FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  로딩 오버레이 (기존 유지)  -->
        <Border
            Grid.RowSpan="2"
            Background="#CC000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    FontSize="14"
                    Foreground="White"
                    Text="세션을 불러오는 중..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>