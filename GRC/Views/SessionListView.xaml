
<UserControl
    x:Class="GRC.Views.SessionListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:GRC.ViewModels"
    Background="#121212"
    Loaded="UserControl_Loaded"
    Style="{StaticResource FadeInViewStyle}">

    <!--  상단 헤더 및 본문  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  상단 헤더  -->
        <Border
            Grid.Row="0"
            Background="#CC111111"
            BorderBrush="#222222"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="내 대화 목록" />
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Padding="12,6"
                        Command="{Binding CreateNewSessionCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="11"
                                Height="11"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconPlus}"
                                Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="새 대화 시작" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Command="{Binding OpenArchitectCommand}"
                        Style="{StaticResource HeaderActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconSparkles}"
                                Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center" Text="AI 세션 아키텍트" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="10,0,0,0"
                        Padding="8,6"
                        Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource HeaderActionButton}"
                        ToolTip="설정">
                        <Path
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            Data="{StaticResource IconSettings}"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  카드 리스트 영역  -->
        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <Grid>
                <!--  세션이 0개일 때 나타나는 웰컴 온보딩 카드  -->
                <Border
                    Margin="30,40"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#18181A"
                    BorderBrush="#2A2A2D"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="450" HorizontalAlignment="Center">
                        <Path
                            Width="28"
                            Height="28"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            Data="{StaticResource IconSparkles}"
                            Fill="#008B99"
                            Stretch="Uniform" />
                        <TextBlock
                            Margin="0,10,0,10"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="GRC에 오신 것을 환영합니다!" />
                        <TextBlock
                            Margin="0,0,0,25"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="#A0A0A0"
                            Text="한 줄의 키워드로 당신만의 AI 롤플레잉 서사를 만들어보세요."
                            TextWrapping="Wrap" />

                        <!--  상태별 안내 버튼  -->
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button
                                Padding="16,10"
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource AccentBlueActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconSettings}"
                                        Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        Stretch="Uniform" />
                                    <TextBlock FontWeight="Bold" Text="API 키 설정하기" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="12,0,0,0"
                                Padding="16,10"
                                Command="{Binding OpenArchitectCommand}"
                                Style="{StaticResource SuccessActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource IconSparkles}"
                                        Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        Stretch="Uniform" />
                                    <TextBlock FontWeight="Bold" Text="AI 세션 만들기" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  세션 리스트  -->
                <ItemsControl Margin="15,0" ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionSummary}">
                        <Button
                            Margin="0,8"
                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!--  모델 말풍선(ModelDialogue) 테마 배경 및 테두리 적용  -->
                                    <Border
                                        x:Name="CardBorder"
                                        Padding="18,15"
                                        Background="#99050505"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="15"
                                                Opacity="0.1"
                                                ShadowDepth="2" />
                                        </Border.Effect>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" LastChildFill="False">
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Foreground="#F2F2F2"
                                                    Text="{Binding PresetName}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Right"
                                                    FontSize="11"
                                                    Foreground="#AAB2C0"
                                                    Text="{Binding LastModified, StringFormat='MM/dd HH:mm'}" />
                                            </DockPanel>

                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,6,0,0"
                                                FontSize="13"
                                                Foreground="#AAB2C0"
                                                Text="{Binding LastMessagePreview}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!--  삭제 버튼  -->
                                            <Button
                                                Margin="0,-5,-10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}">
                                                <Path
                                                    Width="10"
                                                    Height="10"
                                                    Data="{StaticResource IconClose}"
                                                    Stretch="Uniform"
                                                    Stroke="#888888"
                                                    StrokeThickness="2" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!--  호버 시 테마 전환  -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Background" Value="#BB111111" />
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#44FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!--  로딩 오버레이  -->
        <Border
            Grid.RowSpan="2"
            Background="#CC000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    FontSize="14"
                    Foreground="White"
                    Text="세션을 불러오는 중..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>